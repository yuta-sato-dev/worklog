{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Worklog",
  "version": "0.5.0",
  "identifier": "jp.local.worklog",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Worklog — 今日の作業", "width": 1120, "height": 780, "minWidth": 720, "minHeight": 500 }],
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "作業を記録して、一日を振り返る",
    "category": "Productivity"
  }
}
